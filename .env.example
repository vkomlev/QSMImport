# --------- DB (обязательно) ----------
# SQLAlchemy URL, напр.: mysql+pymysql://user:pass@host/db?charset=utf8mb4
DB_URL=

# --------- Google Sheets ----------
GSHEETS_SPREADSHEET_ID=
GSHEETS_WORKSHEET_NAME=
# Путь к credentials JSON сервис-аккаунта (для gspread)
GSHEETS_SERVICE_ACCOUNT_JSON=

# --------- LMS API ----------
# Базовый URL LMS Core API, например: http://localhost:8000
LMS_API_BASE_URL=
# API-ключ, передаётся в query-параметре ?api_key=...
LMS_API_KEY=
# Таймаут HTTP-запросов к LMS API, сек. (по умолчанию 10.0)
LMS_API_TIMEOUT=
# true — только валидация, без записи задач в LMS (по умолчанию false)
LMS_IMPORT_DRY_RUN=

# --------- Import behavior ----------
# Баллы по умолчанию для коротких ответов (по умолчанию 10.0)
DEFAULT_POINTS_SHORT_ANSWER=
# Добавлять ли блок "Входные данные" в текст вопроса (по умолчанию true)
PREPEND_INPUT_LINK=
# Подпись блока "Входные данные" (по умолчанию "Входные данные")
INPUT_LINK_LABEL=

# --------- Logging ----------
LOG_DIR=
LOG_LEVEL=
LOG_FILE=
LOG_MAX_BYTES=
LOG_BACKUP_COUNT=

# --------- WordPress post meta (сценарий QSM) ----------
# URL сайта для создаваемых постов квизов (по умолчанию https://victor-komlev.ru/)
SITE_URL=
# ID автора WordPress-поста квиза (по умолчанию 3)
WP_AUTHOR_ID=
